### Example environment variables for production deployment
# Copy this file to .env (or set these in your hosting provider) and fill values.

# Database (one of these must be set)
MONGODB_URI=
# or
DATABASE_URL=

# Public site URL (used for canonical links / CORS)
PUBLIC_SITE_URL=
# fallback: SITE_URL
SITE_URL=

# Server port (optional)
PORT=3000

# Node environment
NODE_ENV=production

# Contact forwarding (optional) - for sending contact messages
CONTACT_FORWARD_TO_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM_EMAIL=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Token used to secure cache invalidation endpoint (optional but recommended)
CACHE_INVALIDATE_TOKEN=
